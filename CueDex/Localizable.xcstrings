    "Only CueDex's global plugin is added or removed. It applies to local projects. Other plugins and saved cue settings are preserved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only CueDex's global plugin is added or removed. It applies to local projects. Other plugins and saved cue settings are preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅添加或移除 CueDex 的全局插件，作用于本地项目。其他插件和已保存的提醒配置会保留。"
          }
        }
      }
    },
    "Only CueDex's Stop hook is added or removed. Other hooks and saved cue settings are preserved." : {
      "localizations" : {
        "en" : {
